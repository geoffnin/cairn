// Cairn go-links server. See ../README.md for setup, or use the "Deploy to Cloudflare" button there.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cairn",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // The web UI: static files built from ../web (npm run build:ui) into ./public/_/. Every request
  // still goes to the Worker first, so sign-in is checked before any of them is served
  // (src/ui.ts); the Worker then hands the request to the assets binding.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  // The workers.dev URL gives a fresh install a working address before any custom domain exists.
  // Turning on Cloudflare Access for the Worker protects it, and Cairn refuses every request that
  // Access has not signed in, so it is never open. Preview URLs stay off: Access does not
  // identify users on them, so Cairn would refuse everything there anyway.
  "workers_dev": true,
  "preview_urls": false,
  // Logs, including one "cairn.link.click" event per visit (see src/events.ts).
  // To send them to Grafana, Datadog, Honeycomb, New Relic, Sentry or any OTLP logs endpoint,
  // create a destination in the Cloudflare dashboard and list its name under "destinations".
  // Keep head_sampling_rate at 1 so counts are exact.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true, // Cloudflare's own per-request log line; false halves log volume
      "persist": true,         // also keep them in Workers Logs, queryable in the dashboard
      "destinations": []       // e.g. ["grafana-logs"]
    },
    // Traces: the runtime records the request and every KV, D1 and fetch call; Cairn adds spans
    // for the redirect lookup (which cache layer answered), sign-in and API calls (src/tracing.ts).
    // Sampled at 10%: traces are for latency, not counting. Send them to any OTLP endpoint the
    // same way as logs: create a destination in the dashboard and list its name here.
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
      "destinations": []       // e.g. ["grafana-traces"]
    }
  },

  // Put the Worker on your own hostname, e.g. go.example.com:
  // "routes": [{ "pattern": "go.example.com", "custom_domain": true }],

  // No IDs: the first `wrangler deploy` (or the Deploy to Cloudflare button) creates the
  // database and namespace, named after the Worker ("cairn-db", "cairn-cache"), and later deploys
  // keep using them. To use resources you already have, add "database_id" / "id" here.
  "d1_databases": [{ "binding": "DB", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "CACHE" }],

  "vars": {
    // Sign-in is done by Cloudflare Access. Turn on Access for this Worker in its settings in the
    // Cloudflare dashboard; nothing needs configuring here. See README, "Turn on Cloudflare Access".
    "AUTH_MODE": "access",        // "dev" for `wrangler dev` on localhost only
    // Only if you protect the hostname with a separate Access application instead of turning
    // Access on for the Worker: your team domain and that application's AUD tag.
    "ACCESS_TEAM_DOMAIN": "",     // e.g. your-team.cloudflareaccess.com
    "ACCESS_AUD": "",

    // --- authorization ---
    "ADMIN_EMAILS": "",           // comma separated; admins can edit/delete any link
    // Comma separated group names from your identity provider, as Access reports them.
    "ADMIN_GROUPS": "",
    // Restrict to these email domains, e.g. "example.com,example.co.uk". Empty = whoever the
    // Access policy lets in. Checked on every request, on top of the Access policy.
    "ALLOWED_EMAIL_DOMAINS": "",

    // How long each Worker instance reuses a redirect it has looked up, in seconds (0-3600).
    // After an edit, other instances can send people to the old destination for up to this
    // long, plus about a minute for KV to update everywhere. 0 turns this layer off.
    "REDIRECT_CACHE_SECONDS": "30",

    // --- link metrics (optional) ---
    // Where each link's "Metrics" link goes, typically a dashboard built on the
    // "cairn.link.click" log events. {slug} is replaced with the link's name, e.g.
    // https://your-stack.grafana.net/d/abc123/cairn-links?var-slug={slug}
    "METRICS_DASHBOARD_URL": ""
  }
}
