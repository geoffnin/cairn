// Cairn go-links server. See ../README.md for setup.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cairn",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Logs, including one "cairn.link.click" event per visit (see src/events.ts).
  // To send them to Grafana, Datadog, Honeycomb, New Relic, Sentry or any OTLP logs endpoint,
  // create a destination in the Cloudflare dashboard and list its name under "destinations".
  // Keep head_sampling_rate at 1 so counts are exact.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true, // Cloudflare's own per-request log line; false halves log volume
      "persist": true,         // also keep them in Workers Logs, queryable in the dashboard
      "destinations": []       // e.g. ["grafana-logs"]
    }
  },

  // Put the Worker on your own hostname, e.g. go.example.com:
  // "routes": [{ "pattern": "go.example.com", "custom_domain": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cairn",
      // Replace with the id printed by `wrangler d1 create cairn`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      // Replace with the id printed by `wrangler kv namespace create CACHE`.
      "id": "00000000000000000000000000000000"
    }
  ],

  "vars": {
    // "oidc"   - built-in OpenID Connect login (Okta, Entra ID, Google, Keycloak, ...)
    // "access" - trust Cloudflare Access in front of the Worker (use this for SAML IdPs)
    // "dev"    - no login; only honoured on localhost
    "AUTH_MODE": "oidc",

    // --- AUTH_MODE=oidc ---
    "OIDC_ISSUER": "",          // e.g. https://your-org.okta.com
    "OIDC_CLIENT_ID": "",
    "OIDC_SCOPES": "openid email profile",
    // secrets: OIDC_CLIENT_SECRET, SESSION_SECRET  (wrangler secret put ...)

    // --- AUTH_MODE=access ---
    "ACCESS_TEAM_DOMAIN": "",   // e.g. your-team.cloudflareaccess.com
    "ACCESS_AUD": "",           // Application Audience (AUD) tag

    // --- authorization ---
    "ADMIN_EMAILS": "",          // comma separated; admins can edit/delete any link
    "ADMIN_GROUPS": "",          // comma separated; matched against the `groups` claim
    // Restrict sign-in to these email domains, e.g. "example.com,example.co.uk".
    // Empty = anyone your IdP lets in. Checked at sign-in and again on every request.
    "ALLOWED_EMAIL_DOMAINS": "",

    "SESSION_TTL_HOURS": "24",

    // The word typed before the slash: "go" gives go/roadmap. One DNS label (letters, digits, hyphens).
    "LINK_PREFIX": "go",

    // How long the browser extension stays signed in after its one-time sign-in.
    "EXTENSION_TOKEN_TTL_DAYS": "30",

    // --- link metrics (optional) ---
    // Where the usage count in the UI links to, typically a dashboard built on the
    // "cairn.link.click" log events. {slug} is replaced with the link's name, e.g.
    // https://your-stack.grafana.net/d/abc123/cairn-links?var-slug={slug}
    "METRICS_DASHBOARD_URL": ""
  }
}
