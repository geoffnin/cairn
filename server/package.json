{
  "name": "cairn-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "cd .. && npm run build -w web",
    "dev": "npm run build:ui && wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "npm run build:ui && vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.163.0"
  }
}
