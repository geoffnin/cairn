{
  "manifest_version": 3,
  "name": "Cairn Go Links",
  "version": "0.6.0",
  "description": "Type go/name in the address bar to open short links, kept in this browser or on your team's Cairn server.",
  "minimum_chrome_version": "123",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://go/*",
    "https://www.google.com/*",
    "https://www.bing.com/*",
    "https://duckduckgo.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Create a go link for this page"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "omnibox": {
    "keyword": "go"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "go.html"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}
