{
  "name": "cairn",
  "private": true,
  "type": "module",
  "workspaces": [
    "ui",
    "web",
    "extension"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build -w web -w extension",
    "check": "node design/build-tokens.mjs --check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test": "vitest run && npm test -w extension",
    "tokens": "node design/build-tokens.mjs"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-svelte-csf": "^5.1.6",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/svelte-vite": "^10.6.7",
    "@testing-library/svelte": "^5.4.2",
    "@types/chrome": "^0.3.7",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.63.0",
    "storybook": "^10.6.7",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
