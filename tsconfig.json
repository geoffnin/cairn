{
  // Type-checks the shared UI and its stories, the server's web app and the extension (svelte-check).
  // The Worker has its own tsconfig in server/.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "chrome"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["ui/src", "web/src", "extension/src", "extension/*.js", ".storybook/*.ts"]
}
